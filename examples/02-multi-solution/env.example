# Local environment template for scripts/deploy_fabric_workspace.py
#
# The pipeline supplies these from variable groups. This file is for running a
# single solution/environment by hand.

# Which solution to deploy. Must match a key in config/solutions.yml.
SOLUTION_KEY=ved

# Service principal
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# Target workspace. In the pipeline this comes from the variable named in
# config/solutions.yml, for example VED_UAT_WORKSPACE_ID.
TARGET_WORKSPACE_ID=
TARGET_ENVIRONMENT_NAME=DEV

# Source folder for this solution. Must point at a single solution folder.
# The script rejects a value that resolves to the repository root, because a
# root-scoped deployment would sweep every solution into one workspace.
# Leave empty to resolve it from config/solutions.yml.
REPOSITORY_DIRECTORY=./fabric-workspaces/Ved

# Deployment behaviour
VALIDATE_ONLY=true
REMOVE_ORPHANS=true
ENABLE_SHORTCUT_PUBLISH=true
EXCLUDE_FOLDERS=
ITEM_TYPES_IN_SCOPE=
LOG_LEVEL=INFO

# Safety override. Leave false. Setting this true lets a deployment proceed from
# a solution folder containing no Fabric items, which with REMOVE_ORPHANS=true
# will empty the target workspace.
ALLOW_EMPTY_SOURCE=false
